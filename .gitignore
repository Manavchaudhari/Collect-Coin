# This .gitignore is for the CollectCoin Unity project.
# Base rules: standard Unity template (github/gitignore Unity.gitignore)

/[Ll]ibrary/
/[Tt]emp/
/[Oo]bj/
/[Bb]uild/
/[Bb]uilds/
/[Ll]ogs/
/[Uu]ser[Ss]ettings/
/[Mm]emoryCaptures/
/[Rr]ecordings/

# Autogenerated VS/Rider/MD solution and project files
.vs/
.gradle/
ExportedObj/
.consulo/
*.csproj
*.unityproj
*.sln
*.suo
*.tmp
*.user
*.userprefs
*.pidb
*.booproj
*.svd
*.pdb
*.mdb
*.opendb
*.VC.db

*.pidb.meta
*.pdb.meta
*.mdb.meta

sysinfo.txt
crashlytics-build.properties

*.apk
*.aab
*.unitypackage
*.app

# ---- Project-specific additions ----

# SkySeries Freebie / Stylized Texture Pack: vendor content, not for raw redistribution, free to use.
/Assets/SkySeries Freebie/
/Assets/Stylized Texture Pack/

# Forest Map: same vendor-content rule applies to everything in this package,
# EXCEPT Forest_scene.unity, which is the ACTUAL scene the game runs on and is
# the user's own work (Player/GameManager wiring, coin placement, triggers) -
# it only references the vendor's meshes/textures by GUID, it doesn't embed
# them, so excluding everything else in this tree still keeps the vendor's
# binary assets out while keeping the one file that shows the real project.
/Assets/Forest Map/*
!/Assets/Forest Map/Forest Pack/
/Assets/Forest Map/Forest Pack/*
!/Assets/Forest Map/Forest Pack/Scenes/
/Assets/Forest Map/Forest Pack/Scenes/*
!/Assets/Forest Map/Forest Pack/Scenes/Forest_scene.unity
!/Assets/Forest Map/Forest Pack/Scenes/Forest_scene.unity.meta
GITIGNORE_EOF